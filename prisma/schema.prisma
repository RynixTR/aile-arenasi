generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Room {
  id String @id @default(cuid())
  code String @unique @db.VarChar(6)
  status String @default("lobby")
  state Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  players Player[]
  sessions GameSession[]
  events RoomEvent[]
  @@index([status, updatedAt])
}
model Player {
  id String @id
  roomId String
  room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
  name String @db.VarChar(24)
  avatar String @db.VarChar(12)
  score Int @default(0)
  connected Boolean @default(false)
  createdAt DateTime @default(now())
  sessions PlayerSession[]
  answers Answer[]
  scores Score[]
  @@index([roomId])
}
model PlayerSession {
  id String @id @default(cuid())
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model GameSession {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
  game String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  rounds GameRound[]
  scores Score[]
  @@index([roomId,game])
}
model GameRound {
  id String @id @default(cuid())
  sessionId String
  session GameSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  number Int
  prompt Json
  startedAt DateTime @default(now())
  endsAt DateTime?
  answers Answer[]
  @@unique([sessionId,number])
}
model Question {
  id String @id @default(cuid())
  game String
  category String
  prompt String
  data Json
  @@index([game,category])
}
model Answer {
  id String @id @default(cuid())
  roundId String
  round GameRound @relation(fields:[roundId],references:[id],onDelete:Cascade)
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
  value Json
  submittedAt DateTime @default(now())
  @@unique([roundId,playerId])
}
model Score {
  id String @id @default(cuid())
  sessionId String
  session GameSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  playerId String
  player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
  points Int
  @@unique([sessionId,playerId])
}
model RoomEvent {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
  kind String
  data Json
  createdAt DateTime @default(now())
  @@index([roomId,createdAt])
}
